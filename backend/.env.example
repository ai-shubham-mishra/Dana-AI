# Copy to backend/.env and fill in. Never commit .env.

# Local infra from the root docker-compose.yml
MONGO_URI=mongodb://dana:dana-dev-password@localhost:27017/?authSource=admin
MONGO_DB=dana_ai

# Azurite (local blob emulator). Well-known dev connection string.
BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
BLOB_CONTAINER=dana-ai-files

# Access-token verification. The HS256 secret is NOT set here: it is read from Key Vault
# secret JWT-MASTER-TOKEN at startup (same secret as analytics-studio / DeepAgent).
JWT_ISSUER=omnidoc
# Leave empty until the token issuer adds an aud claim
JWT_AUDIENCE=
JWT_LEEWAY_SECONDS=0

CORS_ORIGINS=["http://localhost:3000"]
APP_ENV=development

# Azure Key Vault (read-only service principal). Secret values are never stored here.
# Secrets read at runtime: JWT-MASTER-TOKEN, AZURE-FOUNDARY-SC-API-ENDPOINT, AZURE-FOUNDARY-SC-API-KEY
AZURE_KEYVAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Claude model deployment name used by the agent
LLM_MODEL=claude-sonnet-5-5
